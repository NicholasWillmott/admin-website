#!/bin/bash

# Fill-missing snapshot of country module-defaults baselines into the public
# resource hub (module_defaults_baseline.json). Adds v2 countries with no
# entry; never overwrites one. Dry run unless --commit.
#
# Usage:
#   STATUS_API_KEY=... ./snapshot_module_defaults
#   STATUS_API_KEY=... GITHUB_PAT_RESOURCE_HUB=... ./snapshot_module_defaults --commit

set -e
cd "$(dirname "$0")/src/backend"
exec deno run --allow-net --allow-env --allow-read -c deno.json snapshot_module_defaults.ts "$@"
